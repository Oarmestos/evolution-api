# =========================================================================
#             Evolution API - Entorno de Producción (.env)
# =========================================================================

SERVER_NAME=avri-prod
SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=https://api.tudominio.com # CAMBIAR POR EL DOMINIO DE PRODUCCIÓN

# Seguridad y Autenticación
NODE_ENV=production
AUTHENTICATION_API_KEY=generar_aqui_una_apikey_de_alta_entropia_mayor_a_16_chars

# Sentry (Opcional, monitoreo de errores)
Sentry_DSN=

# Telemetría
TELEMETRY_ENABLED=false

# Métricas de Prometheus (Recomendado para observabilidad)
PROMETHEUS_METRICS=true
METRICS_AUTH_REQUIRED=true
METRICS_USER=admin_metrics
METRICS_PASSWORD=generar_password_seguro_aqui # CAMBIAR EN PRODUCCIÓN

# Orígenes CORS permitidos
CORS_ORIGIN=https://admin.tudominio.com # Reemplazar con el dominio de la interfaz de administración
CORS_METHODS=GET,POST,PUT,DELETE
CORS_CREDENTIALS=true

# Logs de producción (Optimizado para evitar sobrecarga de escritura en disco)
LOG_LEVEL=ERROR,WARN,INFO
LOG_COLOR=false
LOG_BAILEYS=error

# Base de Datos (PostgreSQL multi-tenant)
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI='postgresql://postgres:secure_password_here@postgres-prod:5432/avri_db?schema=avri_api&connection_limit=20'
DATABASE_CONNECTION_CLIENT_NAME=avri_prod

# Determinar qué guardar en BD (Reducido para optimizar operaciones IOPS)
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_DATA_HISTORIC=false # Desactivado para ahorrar espacio en discos de producción
DATABASE_SAVE_IS_ON_WHATSAPP=true
DATABASE_SAVE_IS_ON_WHATSAPP_DAYS=7

# Almacenamiento Local / Caché Local deshabilitado a favor de Redis
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis-prod:6379/0
CACHE_REDIS_KEY_PREFIX=avri_prod

# Almacenamiento Externo S3 (Mandatorio en producción para multimedia)
# STORAGE_TYPE=s3
# STORAGE_S3_ACCESS_KEY=tu_access_key
# STORAGE_S3_SECRET_KEY=tu_secret_key
# STORAGE_S3_BUCKET=tu_bucket_name
# STORAGE_S3_PORT=443
# STORAGE_S3_ENDPOINT=s3.amazonaws.com
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_SSL=true
